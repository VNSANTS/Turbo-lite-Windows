<Window x:Class="TurboLite.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Turbo Lite Windows" Height="760" Width="1180" MinHeight="650" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#0D1423" CornerRadius="18" Padding="18" Margin="0,0,18,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="TURBO LITE" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="WINDOWS TOOLKIT" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="1,3,0,28"/>
                    <TextBlock Text="PAINEL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
                    <Border Background="#173148" CornerRadius="9" Padding="12" Margin="0,0,0,6"><TextBlock Text="◈  Visão geral" FontWeight="SemiBold"/></Border>
                    <Button Content="▤  Processos" Click="OpenProcesses_Click" HorizontalContentAlignment="Left" Padding="12,9" Margin="0,0,0,8" Background="#111D30" Foreground="{StaticResource MutedBrush}" BorderBrush="#25334A"/>
                    <Button Content="◷  Inicialização" Click="OpenStartup_Click" HorizontalContentAlignment="Left" Padding="12,9" Margin="0,0,0,8" Background="#111D30" Foreground="{StaticResource MutedBrush}" BorderBrush="#25334A"/>
                    <Button Content="▧  Armazenamento" Click="OpenStorage_Click" HorizontalContentAlignment="Left" Padding="12,9" Margin="0,0,0,8" Background="#111D30" Foreground="{StaticResource MutedBrush}" BorderBrush="#25334A"/>
                    <Button Content="◷  Histórico de ações" Click="OpenHistory_Click" HorizontalContentAlignment="Left" Padding="12,9" Margin="0,0,0,8" Background="#111D30" Foreground="{StaticResource MutedBrush}" BorderBrush="#25334A"/><Button Content="▧  Limpeza segura" Click="OpenCleanup_Click" HorizontalContentAlignment="Left" Padding="12,9" Margin="0,0,0,8" Background="#111D30" Foreground="{StaticResource MutedBrush}" BorderBrush="#25334A"/>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="#111D30" CornerRadius="10" Padding="12" Margin="0,20,0,0">
                    <StackPanel><TextBlock Text="MODO CONTROLADO" Foreground="#5DE0A5" FontSize="11" FontWeight="Bold"/><TextBlock Text="Diagnóstico e ações manuais controladas. Ajustes permanentes do Windows não são aplicados automaticamente." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/></StackPanel>
                </Border>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,22">
                <StackPanel><TextBlock Text="Visão geral" FontSize="28" FontWeight="Bold"/><TextBlock Text="Diagnóstico em tempo real do seu computador" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="▤  Processos" Click="OpenProcesses_Click" Padding="12,9" Margin="0,0,6,0" Background="#17243A" BorderBrush="#34445F"/><Button Content="◷  Inicialização" Click="OpenStartup_Click" Padding="12,9" Margin="0,0,6,0" Background="#17243A" BorderBrush="#34445F"/><Button Content="▧  Armazenamento" Click="OpenStorage_Click" Padding="12,9" Margin="0,0,6,0" Background="#17243A" BorderBrush="#34445F"/><Button Content="↻  Atualizar" Click="Refresh_Click" Padding="12,9" Background="#12384A" BorderBrush="#23627A"/></StackPanel>
            </Grid>
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="MEMÓRIA RAM" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="RamValue" Text="Lendo…" FontSize="27" FontWeight="Bold" Margin="0,12,0,3"/><TextBlock x:Name="RamDetail" Text="Memória disponível" Foreground="{StaticResource MutedBrush}" FontSize="12"/><ProgressBar x:Name="RamBar" Height="5" Margin="0,15,0,0" Maximum="100"/></StackPanel></Border>
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="5,0"><StackPanel><TextBlock Text="DISCO DO SISTEMA" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="DiskValue" Text="Lendo…" FontSize="27" FontWeight="Bold" Margin="0,12,0,3"/><TextBlock x:Name="DiskDetail" Text="Espaço utilizado" Foreground="{StaticResource MutedBrush}" FontSize="12"/><ProgressBar x:Name="DiskBar" Height="5" Margin="0,15,0,0" Maximum="100"/></StackPanel></Border>
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="10,0,0,0"><StackPanel><TextBlock Text="PROCESSOS" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="ProcessValue" Text="Lendo…" FontSize="27" FontWeight="Bold" Margin="0,12,0,3"/><TextBlock x:Name="ProcessDetail" Text="Memória ocupada pelos processos" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock Text="Contagem aproximada" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,14,0,0"/></StackPanel></Border>
            </UniformGrid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,9,0"><StackPanel><TextBlock Text="Seu sistema" FontSize="18" FontWeight="Bold"/><TextBlock Text="INFORMAÇÕES DO HARDWARE" FontSize="10" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" Margin="0,18,0,10"/><TextBlock Text="Processador" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="CpuName" Text="Detectando processador…" TextWrapping="Wrap" FontSize="14" Margin="0,4,0,14"/><TextBlock Text="Sistema operacional" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="OsName" Text="Detectando Windows…" TextWrapping="Wrap" FontSize="14" Margin="0,4,0,14"/><TextBlock Text="Status da análise" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="StatusText" Text="Preparando diagnóstico…" Foreground="#5DE0A5" FontSize="13" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="9,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Recomendações" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="BASEADAS NAS MÉTRICAS ATUAIS" FontSize="10" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" Margin="0,18,0,14"/>
                        <ItemsControl x:Name="RecommendationList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#17243A" BorderBrush="{Binding Accent}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,9">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{Binding Accent}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding Action}" TextWrapping="Wrap" Foreground="#C5D0E2" FontSize="11" Margin="0,7,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Grid.Row="3" x:Name="FooterText" Text="Turbo Lite Windows • Diagnóstico somente leitura" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="2,14,0,0"/>
        </Grid>
    </Grid>
</Window>
