<Window x:Class="TurboLite.Windows.StartupManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Turbo Lite Windows — Inicialização" Height="660" Width="1000"
        MinHeight="500" MinWidth="780" WindowStartupLocation="CenterOwner"
        Background="#070B16" Foreground="#E8F0FF">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Inicialização automática" FontSize="27" FontWeight="Bold"/>
            <TextBlock Text="Veja o que pode iniciar junto com o Windows, sem alterar configurações."
                       Foreground="#9AAAC4" Margin="0,5,0,0"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock x:Name="CountText" Text="Lendo itens…" VerticalAlignment="Center"
                       Foreground="#9AAAC4" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Desativar selecionado" Click="Disable_Click" Padding="13,8" Margin="0,0,8,0"
                        Background="#51351C" Foreground="#FFE0B2" BorderBrush="#805126"/>
                <Button Content="Restaurar backups" Click="Restore_Click" Padding="13,8" Margin="0,0,8,0"
                        Background="#173D32" Foreground="#C8FFE8" BorderBrush="#28634F"/>
                <Button Content="↻ Atualizar" Click="Refresh_Click" Padding="13,8"
                        Background="#12384A" Foreground="#E8F0FF" BorderBrush="#23627A"/>
            </StackPanel>
        </DockPanel>
        <DataGrid x:Name="StartupGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                  CanUserAddRows="False"
                  Background="#0E1526" Foreground="#E8F0FF" BorderBrush="#25334A"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  RowBackground="#0E1526" AlternatingRowBackground="#111D30"
                  HorizontalGridLinesBrush="#25334A" VerticalGridLinesBrush="#25334A">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="1.4*"/>
                <DataGridTextColumn Header="Origem" Binding="{Binding Source}" Width="1.25*"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="90"/>
                <DataGridTextColumn Header="Comando ou caminho" Binding="{Binding Command}" Width="3*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="3" Background="#17243A" CornerRadius="9" Padding="12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Modo de inspeção" Foreground="#5DE0A5" FontWeight="Bold"/>
                <TextBlock Text="A desativação é limitada a entradas compatíveis da chave Run do usuário atual e atalhos .lnk da pasta de inicialização pessoal. O Turbo Lite guarda backup antes de alterar e não sobrescreve entradas/atalhos recriados. Itens do sistema, RunOnce e a pasta compartilhada são somente leitura. Não desative itens desconhecidos: alguns são importantes para segurança ou sincronização."
                           Foreground="#C5D0E2" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>