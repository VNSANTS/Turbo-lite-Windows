<Window x:Class="TurboLite.Windows.CleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Turbo Lite Windows — Limpeza segura" Height="690" Width="1000"
        MinHeight="520" MinWidth="800" WindowStartupLocation="CenterOwner"
        Background="#070B16" Foreground="#E8F0FF">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Limpeza temporária" FontSize="27" FontWeight="Bold"/>
            <TextBlock Text="Prévia antes de excluir. Apenas arquivos dentro da pasta temporária do usuário."
                       Foreground="#9AAAC4" Margin="0,5,0,0"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock x:Name="StatusText" Text="Faça uma prévia para ver os arquivos encontrados."
                       VerticalAlignment="Center" Foreground="#9AAAC4" DockPanel.Dock="Left"/>
            <Button Content="Analisar novamente" Click="Preview_Click" Padding="14,8"
                    HorizontalAlignment="Right" Background="#12384A"
                    Foreground="#E8F0FF" BorderBrush="#23627A"/>
        </DockPanel>
        <Border Grid.Row="2" Background="#111D30" CornerRadius="10" Padding="13" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="SummaryText" Text="Nenhuma prévia executada" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock x:Name="RootText" TextWrapping="Wrap" Foreground="#9AAAC4" FontSize="11" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        <DataGrid x:Name="FileGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" Background="#0E1526" Foreground="#E8F0FF"
                  BorderBrush="#25334A" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  RowBackground="#0E1526" AlternatingRowBackground="#111D30"
                  HorizontalGridLinesBrush="#25334A">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Arquivo temporário" Binding="{Binding Path}" Width="4*"/>
                <DataGridTextColumn Header="Tamanho" Binding="{Binding SizeText}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="Arquivos em uso ou sem permissão serão ignorados. Pastas e links não são removidos."
                       TextWrapping="Wrap" Foreground="#9AAAC4" FontSize="11" VerticalAlignment="Center"/>
            <Button x:Name="CleanButton" Content="Excluir arquivos listados" Click="Clean_Click"
                    IsEnabled="False" Padding="16,10" Margin="14,0,0,0"
                    Background="#51351C" Foreground="#FFE0B2" BorderBrush="#805126"/>
        </DockPanel>
    </Grid>
</Window>