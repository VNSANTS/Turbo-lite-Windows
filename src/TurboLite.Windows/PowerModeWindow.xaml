<Window x:Class="TurboLite.Windows.PowerModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Turbo Lite — Modo de desempenho" Height="660" Width="850"
        MinHeight="560" MinWidth="720" WindowStartupLocation="CenterOwner"
        Background="#070B16" Foreground="#E8F0FF">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Modo de desempenho" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="Troque o plano de energia do Windows com confirmação e opção de restauração."
                       Foreground="#9AAAC4" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#111A2B" BorderBrush="#243149" BorderThickness="1"
                CornerRadius="14" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="PLANO ATIVO" Foreground="#9AAAC4" FontSize="11" FontWeight="Bold"/>
                <TextBlock x:Name="ActivePlanText" Text="Lendo plano atual…" FontSize="20"
                           FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="O modo Desempenho pode aumentar consumo de energia, temperatura e ruído. Em um PC antigo, ele não garante mais FPS nem corrige gargalos de HD ou pouca RAM."
                           Foreground="#FFC93C" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="PLANOS DISPONÍVEIS" FontSize="11" Foreground="#9AAAC4"
                           FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <Button Content="↻ Atualizar" Click="Refresh_Click" Padding="12,7"
                        HorizontalAlignment="Right" DockPanel.Dock="Right"/>
            </DockPanel>
            <DataGrid x:Name="PlansGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                      Background="#0E1526" Foreground="#E8F0FF" BorderBrush="#25334A"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      RowBackground="#0E1526" AlternatingRowBackground="#111D30"
                      HorizontalGridLinesBrush="#25334A">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Plano" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="GUID" Binding="{Binding Guid}" Width="2.2*"/>
                    <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding IsActive}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <WrapPanel>
                <Button Content="⚡ Aplicar desempenho" Click="Performance_Click" Background="#12384A"
                        BorderBrush="#23627A" Padding="14,10" Margin="0,0,8,8"/>
                <Button Content="◉ Aplicar equilibrado" Click="Balanced_Click" Padding="14,10" Margin="0,0,8,8"/>
                <Button Content="☾ Aplicar economia" Click="Saver_Click" Padding="14,10" Margin="0,0,8,8"/>
                <Button Content="↶ Restaurar anterior" Click="Restore_Click" Padding="14,10" Margin="0,0,0,8"/>
            </WrapPanel>
            <TextBlock x:Name="StatusText" Text="As opções dependem dos planos disponíveis no Windows."
                       Foreground="#9AAAC4" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
    </Grid>
</Window>
