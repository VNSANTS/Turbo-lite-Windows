<Window x:Class="TurboLite.Windows.ProcessManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Turbo Lite Windows — Processos" Height="680" Width="1000"
        MinHeight="520" MinWidth="780" WindowStartupLocation="CenterOwner"
        Background="#070B16" Foreground="#E8F0FF">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Gerenciador de processos" FontSize="27" FontWeight="Bold"/>
            <TextBlock Text="Uso de CPU por amostragem de 0,5 s e memória • ações sempre confirmadas"
                       Foreground="#9AAAC4" Margin="0,5,0,0"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock x:Name="CountText" Text="Lendo processos…" VerticalAlignment="Center"
                       Foreground="#9AAAC4" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="↻ Atualizar" Click="Refresh_Click" Padding="16,8" Margin="0,0,8,0"
                        Background="#12384A" Foreground="#E8F0FF" BorderBrush="#23627A"/>
                <Button x:Name="TrimRamButton" Content="Liberar RAM do selecionado" Click="TrimRam_Click"
                        Padding="16,8" Margin="0,0,8,0" Background="#17463D" Foreground="#FFFFFF" BorderBrush="#267B68"
                        IsEnabled="False"/>
                <Button x:Name="TerminateButton" Content="Encerrar selecionado" Click="Terminate_Click"
                        Padding="16,8" Background="#5A2632" Foreground="#FFFFFF" BorderBrush="#8B3548"
                        IsEnabled="False"/>
            </StackPanel>
        </DockPanel>
        <DataGrid x:Name="ProcessGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                  SelectionChanged="ProcessGrid_SelectionChanged"
                  Background="#0E1526" Foreground="#E8F0FF" BorderBrush="#25334A"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  RowBackground="#0E1526" AlternatingRowBackground="#111D30"
                  HorizontalGridLinesBrush="#25334A" VerticalGridLinesBrush="#25334A">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Processo" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="85"/>
                <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" Width="85"/>
                <DataGridTextColumn Header="Memória" Binding="{Binding MemoryText}" Width="120"/>
                <DataGridTextColumn Header="Proteção" Binding="{Binding ProtectionReason}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Text="Selecione um processo para ver as ações disponíveis."
                       Foreground="#9AAAC4" TextWrapping="Wrap"/>
            <TextBlock Text="Atenção: encerrar um aplicativo pode causar perda de trabalho não salvo. Processos protegidos não podem ser encerrados por esta tela."
                       Foreground="#F6C66A" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"/>
        </StackPanel>
    </Grid>
</Window>