<Window x:Class="TurboLite.Windows.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Turbo Lite Windows — Histórico" Height="650" Width="1050"
        MinHeight="500" MinWidth="800" WindowStartupLocation="CenterOwner"
        Background="#070B16" Foreground="#E8F0FF">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Histórico de ações" FontSize="27" FontWeight="Bold"/>
            <TextBlock Text="Registro local das ações executadas pelo Turbo Lite. Não há envio de telemetria."
                       Foreground="#9AAAC4" Margin="0,5,0,0"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock x:Name="CountText" Text="Carregando histórico…" VerticalAlignment="Center"
                       Foreground="#9AAAC4" DockPanel.Dock="Left"/>
            <Button Content="↻ Atualizar" Click="Refresh_Click" Padding="16,8"
                    HorizontalAlignment="Right" Background="#12384A"
                    Foreground="#E8F0FF" BorderBrush="#23627A"/>
        </DockPanel>
        <DataGrid x:Name="HistoryGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" Background="#0E1526" Foreground="#E8F0FF"
                  BorderBrush="#25334A" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  RowBackground="#0E1526" AlternatingRowBackground="#111D30"
                  HorizontalGridLinesBrush="#25334A">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Data/hora" Binding="{Binding Timestamp, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="1.5*"/>
                <DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="*"/>
                <DataGridTextColumn Header="Ação" Binding="{Binding Action}" Width="1.4*"/>
                <DataGridTextColumn Header="Resultado" Binding="{Binding Result}" Width="*"/>
                <DataGridTextColumn Header="Detalhes" Binding="{Binding Details}" Width="3*"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="3" Text="O histórico fica em %LOCALAPPDATA%\TurboLiteWindows\logs\actions.jsonl. Ele pode conter nomes de processos e caminhos locais."
                   Foreground="#9AAAC4" FontSize="11" TextWrapping="Wrap" Margin="2,12,0,0"/>
    </Grid>
</Window>